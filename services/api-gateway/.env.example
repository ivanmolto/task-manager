# Server
PORT=4000
NODE_ENV=development

# Microservices
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=4001
TASK_SERVICE_HOST=localhost
TASK_SERVICE_PORT=4002

# JWT (must match auth-service)
JWT_ACCESS_SECRET=secret-access-key-change-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100